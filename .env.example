# ── Untuk tes lokal & uploader ────────────────────────────────────────────
# Worker dev berjalan di :8787.
BASE_URL=http://127.0.0.1:8787
ADMIN_PASSWORD=ganti-password-lokal
INGEST_TOKEN=ganti-token-uploader

# Vite build lokal (opsional; untuk `npm run dev` tidak diperlukan).
VITE_API_BASE_URL=http://127.0.0.1:8787

# ── Secret Worker lokal ───────────────────────────────────────────────────
# File ini TIDAK dibaca oleh Worker. Salin worker/.dev.vars.example menjadi
# worker/.dev.vars lalu isi ADMIN_PASSWORD_HASH, SESSION_SECRET, INGEST_TOKEN.
